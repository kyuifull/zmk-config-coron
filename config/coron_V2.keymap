/* coron_V2.keymap */

#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

&mt {
    flavor = "balanced";
    quick-tap-ms = <0>;
};

/* Auto-mouse (layer 4) and scroll (layer 5) live in coron_V2_R.overlay as
   input-processors on &trackball_listener. */

/ {
    combos {
        compatible = "zmk,combos";

        /* Positions follow &default_transform in coron_V2.dtsi:
             row0 0..11   row1 12..24   row2 25..38   row3 39..49 */

        lang_e {
            bindings = <&to_layer_0 LANGUAGE_2>;
            key-positions = <16 15>;
            layers = <0 4>;
        };

        lang_j {
            bindings = <&to_layer_0 LANGUAGE_1>;
            key-positions = <20 21>;
            layers = <0 4>;
        };

        double_n {
            bindings = <&double_n>;
            key-positions = <21 22>;
            layers = <0>;
        };

        mo_6 {                      /* td_1 + td_2 held together */
            bindings = <&mo 6>;
            key-positions = <44 47>;
            layers = <0 4>;
        };
    };

    macros {
        to_layer_0: to_layer_0 {
            compatible = "zmk,behavior-macro-one-param";
            #binding-cells = <1>;
            bindings = <&to 0 &macro_param_1to1 &kp MACRO_PLACEHOLDER>;
            label = "TO_LAYER_0";
        };

        double_n: double_N {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp N &kp N>;
            label = "DOUBLE_N";
        };

        /* Arrow symbols via Windows Unicode hex input.
           Requires HKCU\Control Panel\Input Method\EnableHexNumpad = "1"
           (REG_SZ, then sign out/in) and NumLock on. */

        arrow_left: arrow_left {          /* ← : Alt + KP_PLUS + 2190 (Unicode hex input) */
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings
                = <&macro_press &kp LEFT_ALT>
                , <&macro_tap &kp KP_PLUS &kp KP_N2 &kp KP_N1 &kp KP_N9 &kp KP_N0>
                , <&macro_release &kp LEFT_ALT>
                ;
            label = "ARROW_LEFT";
        };

        arrow_up: arrow_up {          /* ↑ : Alt + KP_PLUS + 2191 (Unicode hex input) */
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings
                = <&macro_press &kp LEFT_ALT>
                , <&macro_tap &kp KP_PLUS &kp KP_N2 &kp KP_N1 &kp KP_N9 &kp KP_N1>
                , <&macro_release &kp LEFT_ALT>
                ;
            label = "ARROW_UP";
        };

        arrow_right: arrow_right {          /* → : Alt + KP_PLUS + 2192 (Unicode hex input) */
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings
                = <&macro_press &kp LEFT_ALT>
                , <&macro_tap &kp KP_PLUS &kp KP_N2 &kp KP_N1 &kp KP_N9 &kp KP_N2>
                , <&macro_release &kp LEFT_ALT>
                ;
            label = "ARROW_RIGHT";
        };

        arrow_down: arrow_down {          /* ↓ : Alt + KP_PLUS + 2193 (Unicode hex input) */
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings
                = <&macro_press &kp LEFT_ALT>
                , <&macro_tap &kp KP_PLUS &kp KP_N2 &kp KP_N1 &kp KP_N9 &kp KP_N3>
                , <&macro_release &kp LEFT_ALT>
                ;
            label = "ARROW_DOWN";
        };
    };

    behaviors {
        lt_to_layer_0: lt_to_layer_0 {
            compatible = "zmk,behavior-hold-tap";
            label = "LAYER_TAP_TO_0";
            bindings = <&mo>, <&to_layer_0>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
        };

        td_z: td_z {
            compatible = "zmk,behavior-tap-dance";
            label = "TD_Z";
            #binding-cells = <0>;
            bindings = <&kp Z>, <&kp LC(Z)>, <&kp LC(LS(Z))>;
        };

        td_x: td_x {
            compatible = "zmk,behavior-tap-dance";
            label = "TD_X";
            #binding-cells = <0>;
            bindings = <&kp X>, <&kp LC(X)>;
        };

        td_c: td_c {
            compatible = "zmk,behavior-tap-dance";
            label = "TD_C";
            #binding-cells = <0>;
            bindings = <&kp C>, <&kp LC(C)>;
        };

        td_v: td_v {
            compatible = "zmk,behavior-tap-dance";
            label = "TD_V";
            #binding-cells = <0>;
            bindings = <&kp V>, <&kp LC(V)>;
        };

        td_minus: td_minus {
            compatible = "zmk,behavior-tap-dance";
            label = "TD_MINUS";
            #binding-cells = <0>;
            bindings = <&kp MINUS>, <&kp TILDE>;
        };

        td_question: td_question {
            compatible = "zmk,behavior-tap-dance";
            label = "TD_QUESTION";
            #binding-cells = <0>;
            bindings = <&kp QUESTION>, <&kp EXCLAMATION>;
        };

        /* td_*: tap = key, hold = layer/modifier, tap then hold = key repeat
           (hold-tap with quick-tap-ms). Usage: &td_1 <layer> <key>, etc. */

        td_1: td_1 {
            compatible = "zmk,behavior-hold-tap";
            label = "TD_1";
            #binding-cells = <2>;
            bindings = <&mo>, <&kp>;
            flavor = "balanced";
            tapping-term-ms = <150>;
            quick-tap-ms = <150>;
        };

        td_2: td_2 {
            compatible = "zmk,behavior-hold-tap";
            label = "TD_2";
            #binding-cells = <2>;
            bindings = <&mo>, <&kp>;
            flavor = "balanced";
            tapping-term-ms = <150>;
            quick-tap-ms = <150>;
        };

        td_3: td_3 {
            compatible = "zmk,behavior-hold-tap";
            label = "TD_3";
            #binding-cells = <2>;
            bindings = <&kp>, <&kp>;
            flavor = "balanced";
            tapping-term-ms = <150>;
            quick-tap-ms = <150>;
        };

        td_space: td_space {
            compatible = "zmk,behavior-hold-tap";
            label = "TD_SPACE";
            #binding-cells = <2>;
            bindings = <&kp>, <&kp>;
            flavor = "balanced";
            tapping-term-ms = <150>;
            quick-tap-ms = <150>;
        };

        td_enter: td_enter {
            compatible = "zmk,behavior-hold-tap";
            label = "TD_ENTER";
            #binding-cells = <2>;
            bindings = <&kp>, <&kp>;
            flavor = "balanced";
            tapping-term-ms = <150>;
            quick-tap-ms = <150>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
&kp ESC           &kp Q             &kp L              &kp U      &kp COMMA     &kp PERIOD  &kp F                   &kp W                  &lt 5 R  &kp Y      &kp P          &kp BACKSPACE
&kp TAB  &kp E  &kp I  &kp A  &kp O  &td_minus  &kp RIGHT_SHIFT  &kp K  &kp T  &kp N  &kp S  &kp H  &tog 3
&kp LEFT_SHIFT    &td_z             &td_x              &td_c      &td_v         &kp SLASH   &td_question            &kp RIGHT_CONTROL      &kp G    &kp D      &kp M          &kp J          &kp B  &kp DELETE
&kp LEFT_CONTROL  &kp LEFT_BRACKET  &kp RIGHT_BRACKET  &kp UNDER  &td_3 LEFT_ALT DELETE  &td_1 1 TAB  &td_space LEFT_CONTROL SPACE  &td_enter RIGHT_SHIFT ENTER  &td_2 2 BACKSPACE  &kp COLON  &kp SEMICOLON
            >;

            sensor-bindings = <&inc_dec_kp PAGE_DOWN PAGE_UP>;
        };

        layer_1 {
            bindings = <
&kp ESCAPE        &kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3  &kp NUMBER_4  &kp NUMBER_5  &kp NUMBER_6  &kp NUMBER_7  &kp NUMBER_8  &kp NUMBER_9  &kp NUMBER_0  &kp BACKSPACE
&kp CAPSLOCK  &kp F1  &kp F2  &kp F3  &kp F4  &kp F5  &none  &kp F6  &kp F7  &kp F8  &kp F9  &kp F10  &none
&kp LEFT_SHIFT    &kp F11       &kp F12       &none         &none         &none         &none         &none         &none         &none         &none         &none          &none    &kp DELETE
&kp LEFT_CONTROL  &none         &none         &none         &none         &none         &none         &none         &none         &none         &none
            >;
        };

        layer_2 {
            bindings = <
&kp DOLLAR    &kp HASH       &kp DOUBLE_QUOTES  &kp LEFT_BRACKET      &kp RIGHT_BRACKET      &kp AT_SIGN     &kp HOME  &none  &kp UP_ARROW  &none           &kp PAGE_UP     &sys_reset
&bt BT_SEL 0  &kp AMPERSAND  &kp SINGLE_QUOTE  &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS  &kp UNDERSCORE  &none  &kp END  &kp LEFT_ARROW  &kp DOWN_ARROW  &kp RIGHT_ARROW  &kp PAGE_DOWN  &bootloader
&bt BT_SEL 1  &kp COLON      &kp GRAVE          &kp LEFT_BRACE        &kp RIGHT_BRACE        &kp TILDE       &none     &none  &arrow_left   &arrow_down     &arrow_up       &arrow_right     &none          &bt BT_CLR
&bt BT_SEL 2  &kp SEMICOLON  &none              &none                 &none                  &none           &none     &none  &none         &none           &bt BT_CLR_ALL
            >;
        };

        layer_3 {
            bindings = <
&kp ESCAPE        &none  &none  &none  &none         &none  &kp ASTERISK  &kp PLUS      &kp KP_NUMBER_7  &kp KP_NUMBER_8  &kp KP_NUMBER_9  &kp BACKSPACE
&kp TAB  &none  &none  &none  &none  &none  &none  &kp SLASH  &kp MINUS  &kp KP_NUMBER_4  &kp KP_NUMBER_5  &kp KP_NUMBER_6  &tog 3
&kp LEFT_SHIFT    &none  &none  &none  &none         &none  &none         &none         &kp EQUAL        &kp KP_NUMBER_0  &kp KP_NUMBER_1  &kp KP_NUMBER_2  &kp KP_NUMBER_3  &kp BACKSLASH
&kp LEFT_CONTROL  &none  &none  &none  &kp LEFT_ALT  &none  &kp SPACE     &kp KP_ENTER  &kp KP_DOT       &kp PERCENT      &kp PIPE
            >;

            sensor-bindings = <&inc_dec_kp LC(PAGE_DOWN) LC(PAGE_UP)>;
        };

        layer_4 {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans    &trans    &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &mkp MB1  &mkp MB3  &mkp MB2  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans    &trans    &trans    &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans    &trans
            >;
        };

        layer_5 {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
            >;
        };

        layer_6 {
            bindings = <
&trans  &trans  &trans  &trans        &trans        &trans        &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4    &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3  &trans        &trans        &bootloader   &trans        &trans          &trans  &trans  &bt BT_CLR
&trans  &trans  &trans  &trans        &trans        &trans        &trans        &trans        &trans        &trans        &bt BT_CLR_ALL
            >;
        };
    };
};
